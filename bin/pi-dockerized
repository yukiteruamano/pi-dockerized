#!/bin/bash

# Pi Docker Wrapper Script
# This script makes it easy to run Pi in a secure Docker container.

set -e

# Binary lives in bin/ of the self-contained checkout (Doom-style).
# It is reached via PATH, never via a symlink in ~/.local/bin.
BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(cd "$BIN_DIR/.." && pwd)"
IMAGE_NAME="pi-dockerized:latest"

# Wrapper release line, shown by the version command next to the Pi version and
# the bundled security-guard version.
WRAPPER_VERSION="0.15.0"

# Keep temporary files in the approved scratch dir unless overridden.
# Bare `mktemp` honors TMPDIR, so relay sockets and logs land there.
export TMPDIR="${TMPDIR:-/tmp/pi}"
mkdir -p "$TMPDIR" 2>/dev/null || export TMPDIR="/tmp"

# In-container provider credential check for `auth`. Pi has no `auth login`
# subcommand (interactive login happens through the TUI `/login`); credentials
# are supplied as provider API keys through the secrets file. This only reports
# whether the keys in the environment resolve to a usable credential.
# shellcheck disable=SC2016 # expanded inside the container, not here
AUTH_SCRIPT='
status=0
found=0
echo "== provider credentials =="
check() {
    provider="$1"; var="$2"
    [ -n "${!var:-}" ] || return 0
    found=1
    printf "%s: " "$var"
    if pi auth check --provider "$provider" >/dev/null 2>&1; then
        echo "ready ($provider)"
    else
        echo "not ready ($provider)"; status=1
    fi
}
check anthropic ANTHROPIC_API_KEY
check openai OPENAI_API_KEY
check google GEMINI_API_KEY
check google GOOGLE_API_KEY
if [ "$found" -eq 0 ]; then
    echo "No provider API keys found in the container environment."
    echo "Set them in setting.env_file (e.g. ANTHROPIC_API_KEY=...) and re-run."
    status=1
fi
exit "$status"
'

# In-container diagnostics for the security layer and agent-forwarding setup.
# Read-only: it only reports what is actually usable and exits non-zero on a
# real failure.
# shellcheck disable=SC2016 # expanded inside the container, not here
DOCTOR_SCRIPT='
status=0
note() { printf "%s\n" "$1"; }
echo "== pi =="
pi --version 2>&1 || true
echo "== security guard =="
guard=/home/coder/.pi/agent/extensions/pi-security-guard/index.ts
if [ -f "$guard" ]; then
    grep -m1 PI_DOCKERIZED_GUARD_VERSION "$guard" || true
else
    note "MISSING security-guard extension"; status=1
fi
echo "== agent config =="
agent="${PI_CODING_AGENT_DIR:-/home/coder/.pi/agent}"
[ -f "$agent/settings.json" ] && note "settings.json: present" || { note "settings.json: MISSING"; status=1; }
if [ -f "$agent/mcp.json" ]; then
    if node -e "JSON.parse(require(\"fs\").readFileSync(process.argv[1],\"utf8\"))" "$agent/mcp.json" >/dev/null 2>&1; then
        note "mcp.json: valid"
    else
        note "mcp.json: INVALID JSON"; status=1
    fi
else
    note "mcp.json: MISSING"; status=1
fi
[ -w "$agent/skills" ] && note "skills: writable" || note "skills: NOT writable"
echo "== credentials =="
for v in ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY; do
    if [ -n "${!v:-}" ]; then note "$v: present"; fi
done
echo "== self-update =="
if [ "${PI_SKIP_VERSION_CHECK:-}" = 1 ]; then
    note "version check: disabled"
else
    note "version check: ENABLED (expected PI_SKIP_VERSION_CHECK=1)"; status=1
fi
echo "== ssh agent =="
if [ "${PI_DOCKERIZED_SSH_AGENT:-false}" != true ]; then
    note "ssh agent forwarding: disabled in wrapper config (skipped)"
elif [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    ssh-add -l 2>&1 || true
else
    note "SSH_AUTH_SOCK is unset or not a socket"; status=1
fi
echo "== gnupg =="
if [ "${PI_DOCKERIZED_GPG_AGENT:-false}" != true ]; then
    note "gnupg forwarding: disabled in wrapper config (skipped)"
else
    gpg_home="${GNUPGHOME:-$HOME/.gnupg}"
    [ -S "$gpg_home/S.gpg-agent" ] && note "agent socket: ok" || { note "agent socket: MISSING ($gpg_home/S.gpg-agent)"; status=1; }
    if [ -f "$gpg_home/pubring.kbx" ] || [ -f "$gpg_home/public-keys.d/pubring.db" ]; then
        note "public keyring: ok"
    else
        note "public keyring: MISSING (signed commits will fail)"; status=1
    fi
fi
echo "== env file =="
if [ "${PI_DOCKERIZED_ENV_FILE:-no}" = yes ]; then note "env file: loaded (--env-file)"; else note "env file: not configured"; fi
echo "== result =="
if [ "$status" -eq 0 ]; then note "all good"; else note "problems detected"; fi
exit "$status"
'

# Colors for output (defined before sourcing config-lib so it picks them up)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Source the shared config module
source "$REPO_ROOT/lib/config-lib.sh"

# Function to print colored output
print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Function to check if Docker is running
check_docker() {
    if ! docker info >/dev/null 2>&1; then
        print_error "Docker is not running. Please start Docker and try again."
        exit 1
    fi
}

# Refuse to run as root. The container is launched with the host UID/GID, so a
# root invocation would start the sandbox as root and defeat the whole setup.
check_not_root() {
    if [ "$(id -u)" -eq 0 ]; then
        print_error "Do not run this wrapper as root."
        print_info "Run it as your normal user so the container starts as your host UID/GID."
        exit 1
    fi
}

# Function to build the Docker image
build_image() {
    print_info "Building Pi Docker image..."
    # Regular build uses Docker layer cache normally.
    # Only the 'update' command passes PI_BUILD_TIME to bust the npm cache.
    docker build -t "$IMAGE_NAME" "$REPO_ROOT"
    print_success "Docker image built successfully"
}

# Function to check required host-side configuration (self-contained PI_HOME tree)
check_config() {
    # Ensure the host state tree exists and is seeded (also runs on first use).
    ensure_pi_dirs
}

# Run a one-off Pi CLI command inside the container.
# The project directory is mounted so project-level configuration applies.
# Usage: run_cli_command <name_suffix> <project_dir> <docker_socket> <pi_args...>
run_cli_command() {
    local name_suffix="$1"
    local project_dir="$2"
    local docker_socket="$3"
    shift 3

    if [ -n "$project_dir" ]; then
        if [ ! -d "$project_dir" ]; then
            print_error "Project directory does not exist: $project_dir"
            exit 1
        fi
        project_dir="$(cd "$project_dir" && pwd -P)"
        validate_project_dir "$project_dir" || exit 1
    fi

    check_image "$IMAGE_NAME" || exit 1
    ensure_pi_dirs

    parse_config
    build_mount_args
    build_env_args
    build_env_file_args
    build_common_docker_args
    build_standard_volume_args "$project_dir" "$docker_socket"

    # Allocate a TTY only when attached to one, so the command stays pipeable
    local -a tty_args=(-i)
    [ -t 0 ] && [ -t 1 ] && tty_args=(-it)

    local -a workdir_args=()
    [ -n "$CONTAINER_WORKDIR" ] && workdir_args=(--workdir "$CONTAINER_WORKDIR")

    local -a docker_cmd=(
        docker run "${tty_args[@]}"
        --name "pi-${name_suffix}-$$"
        "${workdir_args[@]}"
        "${DOCKER_COMMON_ARGS[@]}"
        "${VOLUME_ARGS[@]}"
        "${GIT_WORKTREE_ARGS[@]}"
        "${DOCKER_MOUNT_ARGS[@]}"
        "${DOCKER_ENV_ARGS[@]}"
        "${DOCKER_ENV_FILE_ARGS[@]}"
        "$IMAGE_NAME"
        "$@"
    )

    if [ "${DRY_RUN:-false}" = true ]; then
        print_info "Dry run — would execute:"
        dry_run_print "${docker_cmd[@]}"
        stop_gpg_relay "$GPG_RELAY_SOCKET"
        GPG_RELAY_SOCKET=""
        return 0
    fi

    # Stop the per-session GnuPG relay when the container exits (also on error
    # or Ctrl-C via the EXIT/INT/TERM trap).
    trap 'stop_gpg_relay "$GPG_RELAY_SOCKET"' EXIT INT TERM
    "${docker_cmd[@]}"
    stop_gpg_relay "$GPG_RELAY_SOCKET"
    GPG_RELAY_SOCKET=""
    trap - EXIT INT TERM
}

# Build the `pi` invocation args from wrapper settings (theme/model).
# Usage: build_pi_args <array_name>; appends to the named array.
build_pi_args() {
    local -n _out="$1"
    [ -n "$THEME" ] && _out+=(--use-theme "$THEME")
    [ -n "$MODEL" ] && _out+=(--model "$MODEL")
}

# Function to check provider credentials
run_auth() {
    print_info "Checking Pi provider credentials..."
    parse_config
    if ! run_cli_command auth "" false bash -c "$AUTH_SCRIPT"; then
        print_error "No usable provider credentials found."
        print_info "Add provider API keys to setting.env_file and re-run."
        exit 1
    fi
    print_success "Provider credentials are ready."
}

# Function to run Pi
run_pi() {
    local project_dir="${1:-$(pwd)}"
    local dry_run="${DRY_RUN:-false}"

    # Validate project directory exists
    if [ ! -d "$project_dir" ]; then
        print_error "Project directory does not exist: $project_dir"
        exit 1
    fi

    # Convert to absolute, symlink-resolved path (a symlink to $HOME or / must
    # not slip past validate_project_dir).
    project_dir="$(cd "$project_dir" && pwd -P)"

    # Never mount "/", $HOME or an ancestor of $HOME: it would expose the host
    # home (or the whole filesystem) read-write to the agent.
    validate_project_dir "$project_dir" || exit 1

    check_image "$IMAGE_NAME" || exit 1

    # Generate unique container name based on project directory and random suffix
    local dir_name
    dir_name=$(sanitize_container_name "$(basename "$project_dir")")
    local random_suffix
    random_suffix=$(generate_random_suffix)
    local container_name="pi-${dir_name}-${random_suffix}"

    print_info "Starting Pi in Docker..."
    print_info "Project directory: $project_dir"
    print_info "Container name: $container_name"

    # Parse custom config and build docker arguments
    parse_config
    build_mount_args
    build_env_args
    build_env_file_args
    build_common_docker_args
    # Docker socket is opt-in: mounting it is root-equivalent on the host.
    build_standard_volume_args "$project_dir" "$DOCKER_SOCKET"

    local -a pi_args=()
    build_pi_args pi_args

    # Build the full docker run command as an array.
    # CONTAINER_WORKDIR is set by build_standard_volume_args.
    local -a docker_cmd=(
        docker run -it
        --name "$container_name"
        --workdir "$CONTAINER_WORKDIR"
        -e "PI_WORKDIR=$CONTAINER_WORKDIR"
        "${DOCKER_COMMON_ARGS[@]}"
        "${VOLUME_ARGS[@]}"
        "${GIT_WORKTREE_ARGS[@]}"
        "${DOCKER_MOUNT_ARGS[@]}"
        "${DOCKER_ENV_ARGS[@]}"
        "${DOCKER_ENV_FILE_ARGS[@]}"
        "$IMAGE_NAME"
        pi
        "${pi_args[@]}"
    )

    if [ "$dry_run" = true ]; then
        print_info "Dry run — would execute:"
        dry_run_print "${docker_cmd[@]}"
        stop_gpg_relay "$GPG_RELAY_SOCKET"
        GPG_RELAY_SOCKET=""
        return 0
    fi

    if [ "${PI_DOCKERIZED_DEBUG:-}" = 1 ]; then
        print_info "Debug — docker command:"
        dry_run_print "${docker_cmd[@]}"
    fi

    # Pi decides between its TUI and print mode from the terminal: with a TTY it
    # opens the TUI, otherwise it runs in print mode and exits immediately with
    # no output. Warn early so a missing TTY does not look like a silent hang.
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        print_warning "No interactive terminal detected (stdin/stdout is not a TTY)."
        print_info "Pi will start in print mode and exit at once. Run from a real terminal,"
        print_info "or use '$0 exec \"...\"' for non-interactive prompts."
    fi

    # Stop the per-session GnuPG relay when the container exits.
    trap 'stop_gpg_relay "$GPG_RELAY_SOCKET"' EXIT INT TERM
    local rc=0 started ended
    started=$(date +%s)
    "${docker_cmd[@]}" || rc=$?
    ended=$(date +%s)
    stop_gpg_relay "$GPG_RELAY_SOCKET"
    GPG_RELAY_SOCKET=""
    trap - EXIT INT TERM
    if [ "$rc" -ne 0 ]; then
        print_error "Pi exited with an error (container exit code $rc)"
        print_info "Re-run with PI_DOCKERIZED_DEBUG=1 to print the docker command,"
        print_info "and '$0 doctor' to check the in-container setup."
        exit 1
    fi
    # A TUI session lasts until the user quits. Exiting cleanly within a couple
    # of seconds means Pi ran in print mode (no usable TTY) and produced nothing.
    if [ $((ended - started)) -lt 3 ]; then
        print_warning "Pi exited immediately without opening the TUI."
        print_info "That happens when the container has no TTY: Pi falls back to print mode."
        print_info "Re-run with PI_DOCKERIZED_DEBUG=1 to see the docker command, or use"
        print_info "'$0 exec \"...\"' for non-interactive prompts."
    fi
}

# Self-update helpers: `update` and `upgrade` both perform the full upgrade
# (git pull from GitHub + host-state sync + image rebuild). They differ
# only in prompting defaults: `upgrade` asks before pulling when interactive,
# `update` pulls without asking. Both accept [--check] [--yes] [--no-build].
# Usage: _git_pull_wrapper <yes:true|false> <check_only:true|false>
_git_pull_wrapper() {
    local yes="$1" check_only="$2"
    if [ ! -d "$REPO_ROOT/.git" ]; then
        print_error "Not a git checkout ($REPO_ROOT); reinstall with install.sh to enable self-update."
        return 1
    fi
    if ! command -v git >/dev/null 2>&1; then
        print_error "git is required for self-update."
        return 1
    fi
    if ! git -C "$REPO_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        print_error "No upstream tracking branch; set one with 'git branch --set-upstream-to=origin/<branch>'."
        return 1
    fi
    git -C "$REPO_ROOT" fetch origin >/dev/null 2>&1 || {
        print_error "Could not fetch from origin."
        return 1
    }
    local local_rev remote_rev base
    local_rev=$(git -C "$REPO_ROOT" rev-parse HEAD)
    remote_rev=$(git -C "$REPO_ROOT" rev-parse '@{u}')
    base=$(git -C "$REPO_ROOT" merge-base HEAD '@{u}')
    if [ "$local_rev" = "$remote_rev" ]; then
        print_success "Already up to date."
        return 2
    fi
    if [ "$local_rev" != "$base" ]; then
        print_error "Local checkout diverged from upstream; resolve manually with git (no --force pull attempted)."
        git -C "$REPO_ROOT" status -sb | head -5
        return 1
    fi
    local n
    n=$(git -C "$REPO_ROOT" rev-list --count HEAD..'@{u}')
    print_info "Update available: $n commit(s) behind upstream."
    if [ "$check_only" = true ]; then
        return 1
    fi
    if [ "$yes" != true ] && [ -t 0 ]; then
        local ans
        read -r -p "Pull $n commit(s)? (Y/n): " ans || ans=""
        case "${ans:-y}" in
        [Yy] | "") ;;
        *)
            print_info "Aborted."
            return 1
            ;;
        esac
    fi
    git -C "$REPO_ROOT" pull --ff-only || {
        print_error "Pull failed."
        return 1
    }
    print_success "Code updated to latest version."
    return 0
}

# Rebuild the image with cache-busting so the latest Pi is installed.
_rebuild_pi_image() {
    print_info "Rebuilding image with latest code..."
    docker build --build-arg "PI_BUILD_TIME=$(date +%s)" -t "$IMAGE_NAME" "$REPO_ROOT"
    print_info "Updated Pi version:"
    docker run --rm --entrypoint bash "$IMAGE_NAME" -c "pi --version" 2>/dev/null || true
}

# Parse self-update flags shared by `update` and `upgrade`.
# Sets: _UP_CHECK, _UP_YES, _UP_NO_BUILD. Returns 0 on success/--help, 1 on bad usage.
# Usage: _parse_self_update_flags <command-name> [flags...]
_parse_self_update_flags() {
    local cmd="$1"; shift
    _UP_CHECK=false; _UP_YES=false; _UP_NO_BUILD=false
    local arg
    for arg in "$@"; do
        case "$arg" in
        --check) _UP_CHECK=true ;;
        --yes) _UP_YES=true ;;
        --no-build) _UP_NO_BUILD=true ;;
        --help | -h)
            echo "Usage: $0 $cmd [--check] [--yes] [--no-build]"
            echo "  --check    only report whether an update is available"
            echo "  --yes      pull and rebuild without asking"
            echo "  --no-build pull + sync only, skip the image rebuild"
            return 0
            ;;
        *)
            print_error "Unknown $cmd option: $arg (use --check|--yes|--no-build)"
            return 1
            ;;
        esac
    done
    return 0
}

# Full upgrade: git pull + host-state sync + image rebuild.
# Usage: full_upgrade <command-name> [--check] [--yes] [--no-build]
full_upgrade() {
    local cmd="$1"; shift
    _parse_self_update_flags "$cmd" "$@" || return $?
    if [ "$_UP_CHECK" = true ]; then
        _git_pull_wrapper true true
        local check_rc=$?
        if [ "$check_rc" -eq 2 ]; then
            return 0
        fi
        return 1
    fi
    local pull_rc=0
    # `update` never prompts (historic one-shot); `upgrade` prompts when tty.
    if [ "$cmd" = "update" ]; then
        _git_pull_wrapper true false; pull_rc=$?
    else
        _git_pull_wrapper "$_UP_YES" false; pull_rc=$?
    fi
    if [ "$pull_rc" -eq 1 ]; then
        return 1
    fi
    print_success "Refreshing host state..."
    parse_config || true
    sync_pi_state || true
    if [ "$_UP_NO_BUILD" = true ]; then
        print_info "Skipping image rebuild (--no-build)."
        print_success "Upgrade complete (code + config synced, image untouched)."
        return 0
    fi
    check_docker || return 1
    if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        print_info "Image not found, building fresh..."
    else
        print_info "Current Pi version:"
        docker run --rm --entrypoint bash "$IMAGE_NAME" -c "pi --version" 2>/dev/null || true
    fi
    _rebuild_pi_image
    print_success "Upgrade complete (code + config + image)."
}

# Self-update the wrapper checkout from GitHub (Doom-style `doom upgrade`).
# Usage: upgrade_wrapper [--check] [--yes] [--no-build]
upgrade_wrapper() {
    full_upgrade upgrade "$@"
}

# Function to update Pi (full upgrade: git pull + sync + rebuild).
# Usage: update_pi [--check] [--yes] [--no-build]
update_pi() {
    full_upgrade update "$@"
}

# Function to list the models available to the configured providers
# Usage: list_models [search]
list_models() {
    parse_config
    local -a extra=(--list-models)
    if [ -n "${1:-}" ]; then
        extra=(--list-models "$1")
    elif [ -n "$MODEL" ]; then
        extra=(--list-models "$MODEL")
    fi
    run_cli_command models "" false pi "${extra[@]}"
}

# Function to show session usage statistics (best-effort via RPC).
show_stats() {
    parse_config
    # Pi exposes session metrics over its RPC interface (get_session_stats).
    # Best-effort: send the command and let Pi exit on stdin EOF.
    run_cli_command stats "" false bash -c \
        'printf "%s\n" "{\"type\":\"get_session_stats\"}" | timeout 30 pi --mode rpc'
}

# Warn that the Pi agent config is read-only inside the container and point the
# user at the host-side file to edit. Usage: config_readonly_guard <what>
config_readonly_guard() {
    local what="${1:-changes}"
    print_error "The Pi agent config is baked read-only into the image; '$what' is not available from here."
    print_info "MCP servers: edit on the host with '$0 config pi edit' (mcp.json)."
    print_info "Extensions: add to install-extensions and rebuild ('$0 build')."
}

# Function to manage MCP servers (list, login, logout)
manage_mcp() {
    local subcommand="${1:-list}"
    shift || true
    # 'add'/'remove' write to mcp.json, which is mounted read-only; login/logout
    # write OAuth tokens to mcp-auth.json and keep working.
    case "$subcommand" in
    add | remove | rm)
        config_readonly_guard "pi mcp $subcommand"
        exit 1
        ;;
    esac
    parse_config
    run_cli_command mcp "" false pi mcp "$subcommand" "$@"
}

# Function to list installed extensions/packages (read-only).
manage_extensions() {
    local subcommand="${1:-list}"
    shift || true
    # Extensions are installed at image build time (see install-extensions).
    case "$subcommand" in
    add | install | remove | rm | update)
        config_readonly_guard "pi $subcommand"
        exit 1
        ;;
    esac
    parse_config
    run_cli_command extensions "" false pi list "$@"
}

# Diagnose the security layer, credentials and agent forwarding in-container.
# Project-independent: doctor needs no project mount (like auth).
run_doctor() {
    parse_config
    run_cli_command doctor "" false bash -c "$DOCTOR_SCRIPT"
}

# Function to run a non-interactive prompt and print the result
exec_prompt() {
    if [ $# -eq 0 ]; then
        print_error "A message is required: $0 exec \"<message>\" [OPTIONS]"
        exit 1
    fi
    # Docker socket follows the opt-in config, as in 'run'. parse_config must run
    # first so DOCKER_SOCKET reflects setting.docker_socket before it is read.
    parse_config
    run_cli_command exec "$(pwd)" "$DOCKER_SOCKET" pi --print "$@"
}

# Function to clean up Docker image
clean_image() {
    # Drop any relay processes/dirs left by crashed sessions.
    cleanup_stale_relays
    if relay_dir_ok; then
        rm -rf "$GPG_RELAY_DIR" 2>/dev/null || true
    fi
    if docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        print_info "Removing Docker image '$IMAGE_NAME'..."
        docker rmi "$IMAGE_NAME"
        print_success "Docker image removed"
    else
        print_info "Docker image '$IMAGE_NAME' does not exist"
    fi
}

# Function to show or edit configuration
show_config() {
    local subcommand="${1:-show}"
    shift || true

    case "$subcommand" in
    show)
        parse_config
        print_config
        maybe_drift_hint
        ;;
    edit)
        local editor
        if ! editor=$(resolve_editor); then
            print_error "No editor found (set \$EDITOR or install sensible-editor, vi or nano)"
            exit 1
        fi
        if [ ! -f "$CONFIG_FILE" ]; then
            print_warning "Config file does not exist. Running install first..."
            # shellcheck source=lib/install-lib.sh
            source "$REPO_ROOT/lib/install-lib.sh"
            run_install_main --yes --only config || exit 1
        else
            "$editor" "$CONFIG_FILE"
        fi
        ;;
    path)
        echo "$CONFIG_FILE"
        ;;
    sync)
        # Local-only command: (re)create the host-side Pi state (mcp.json,
        # skills, runtime files) without starting a container. With --check it
        # only reports drift.
        parse_config || true
        sync_pi_state "${1:-}"
        ;;
    pi)
        # The Pi agent config (mcp.json) is mounted read-only in the container;
        # edit it here on the host.
        local pi_sub="${1:-path}"
        local mcp="$PI_HOME/.pi/agent/mcp.json"
        case "$pi_sub" in
        path)
            echo "$mcp"
            ;;
        edit)
            local editor
            if ! editor=$(resolve_editor); then
                print_error "No editor found (set \$EDITOR or install sensible-editor, vi or nano)"
                exit 1
            fi
            if [ ! -f "$mcp" ]; then
                print_warning "mcp.json does not exist. Running install first..."
                # shellcheck source=lib/install-lib.sh
                source "$REPO_ROOT/lib/install-lib.sh"
                run_install_main --yes || exit 1
            fi
            "$editor" "$mcp"
            ;;
        *)
            print_error "Usage: $0 config pi [path|edit]"
            exit 1
            ;;
        esac
        ;;
    *)
        print_error "Unknown config subcommand: $subcommand"
        echo "Usage: $0 config [show|edit|path|sync|pi]"
        exit 1
        ;;
    esac
}

# Function to show help
show_help() {
    cat <<EOF
Pi Docker Wrapper

Usage: $0 [COMMAND] [OPTIONS]

Commands:
    run [DIR]           Run Pi in Docker (default: current directory)
    auth                Check provider credentials (from setting.env_file)
    models [DIR]        List models available to the configured providers
    exec MSG [OPTS]     Run a non-interactive prompt (pi --print)
    mcp [ARGS]          Manage MCP servers (list|login|logout; add/remove are host-only)
    extensions [ARGS]   List installed extensions (install is build-time only)
    stats               Show session usage statistics (best-effort)
    doctor              Diagnose guard, config, credentials, SSH/GPG forwarding
    install [OPTS]      First-time install / repair PATH, config, completions, aliases
    upgrade [--check|--yes|--no-build]  Full upgrade: git pull + sync + image rebuild
    build               Build the Docker image
    update [--check|--yes|--no-build]   Full upgrade: git pull + sync + image rebuild
    version             Show wrapper, guard and Pi versions
    config [show|edit|path|sync]      Wrapper config (INI)
    config pi [path|edit]             Pi agent config (mcp.json)
    clean               Remove the Docker image
    help                Show this help message

Environment Variables:
    DRY_RUN=true        Print the Docker command without executing it

Examples:
    $0 run                          # Run in current directory
    $0 run /path/to/project         # Run in specific directory
    $0 auth                         # Check provider credentials
    $0 models                       # List available models
    $0 exec "Explain this repo"     # Non-interactive prompt
    $0 mcp list                     # Show MCP servers and their status
    $0 extensions                   # Show installed extensions
    $0 doctor                       # Diagnose the setup
    $0 build                        # Build the Docker image
    $0 update                       # Full upgrade: git pull + sync + rebuild
    $0 upgrade --check              # Check for updates from GitHub
    $0 config show                  # Show current configuration
    $0 config pi edit               # Edit mcp.json (MCP servers)
    $0 config sync                  # Repair host-side Pi state
    $0 clean                        # Remove Docker image
    DRY_RUN=true $0 run             # Show Docker command without running

Getting Started:
    1. ./install.sh                   # One-liner install (curl|bash): PATH + config
    2. $0 build                       # Build the Docker image (or install --only build)
    3. $0 auth                        # Check provider credentials
    4. $0 run /path/to/project        # Run Pi

Security Features:
    - Isolated environment: only access to mounted project directory
    - Extensions/settings baked read-only into the image at build time
      (edit install-extensions, then rebuild to change them)
    - MCP servers (mcp.json) and the security guard are enforced read-only
    - Persistent state: Pi skills, sessions, auth and MCP OAuth live on the
      host under ~/.config/pi-dockerized/home/ and survive rebuilds
    - Non-root user: runs as the host UID/GID with all capabilities dropped
    - Automatic cleanup: containers are removed on exit (--rm)

Note: The host Docker socket is NOT mounted by default. It is opt-in because it
grants the container full control of the host Docker daemon (root-equivalent
on the host) and defeats the sandbox. Enable it with setting.docker_socket=true
in the config only when you need Docker-in-Docker / Testcontainers.

Security policy: setting.security_policy (strict | balanced | off) controls the
pattern sets enforced by the baked security-guard extension. The default
balanced drops patterns meant for shared cloud sandboxes and other common
false positives while keeping the dangerous ones.

Pi's self-update is disabled inside the container (PI_SKIP_VERSION_CHECK=1).

For more information, see README.md
EOF
}

# Function to show version
show_version() {
    echo "pi-dockerized $WRAPPER_VERSION (guard $(grep -oE 'PI_DOCKERIZED_GUARD_VERSION=[0-9]+' "$REPO_ROOT/extensions/pi-security-guard/index.ts" 2>/dev/null | head -1 || echo unknown))"
    check_image "$IMAGE_NAME" || exit 1
    docker run --rm --entrypoint bash "$IMAGE_NAME" -c "pi --version"
}

# Main script logic
main() {
    check_not_root

    local command="${1:-run}"
    shift || true

    case "$command" in
    run)
        check_docker
        check_config
        run_pi "$@"
        ;;
    auth)
        check_docker
        run_auth
        ;;
    models)
        check_docker
        list_models "$@"
        ;;
    exec)
        check_docker
        exec_prompt "$@"
        ;;
    mcp)
        check_docker
        manage_mcp "$@"
        ;;
    extensions | plugin)
        check_docker
        manage_extensions "$@"
        ;;
    stats)
        check_docker
        show_stats "$@"
        ;;
    debug)
        # Pi has no `debug` subcommand; map to doctor for convenience.
        check_docker
        run_doctor
        ;;
    doctor)
        check_docker
        run_doctor
        ;;
    build)
        check_docker
        build_image
        ;;
    install)
        # shellcheck source=lib/install-lib.sh
        source "$REPO_ROOT/lib/install-lib.sh"
        run_install_main "$@"
        ;;
    upgrade)
        upgrade_wrapper "$@"
        ;;
    uninstall)
        print_info "To uninstall: remove the 'pi-dockerized/bin' PATH line from ~/.bashrc/~/.zshrc,"
        print_info "then delete $REPO_ROOT (config in $CONFIG_DIR is left untouched)."
        ;;
    update)
        update_pi "$@"
        ;;
    version)
        check_docker
        show_version
        ;;
    config)
        # Local-only command: works without a running Docker daemon.
        show_config "$@"
        ;;
    clean)
        check_docker
        clean_image
        ;;
    help | --help | -h)
        show_help
        ;;
    *)
        print_error "Unknown command: $command"
        echo
        show_help
        exit 1
        ;;
    esac
}

# Run main function
main "$@"
