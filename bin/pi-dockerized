#!/bin/bash

# Pi Docker Wrapper Script
# This script makes it easy to run Pi in a secure Docker container.
# It only wires things together: the logic lives in lib/config/ (settings,
# mounts, docker args) and lib/cmd/ (one module per group of commands).

set -e

# Binary lives in bin/ of the self-contained checkout (Doom-style).
# It is reached via PATH, never via a symlink in ~/.local/bin.
BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(cd "$BIN_DIR/.." && pwd)"
# shellcheck disable=SC2034 # consumed by the sourced lib/cmd modules
IMAGE_NAME="pi-dockerized:latest"

# Wrapper release line. It is stamped into the image (org.opencontainers.image
# .version) so a stale image is noticed, and shown by the version command next
# to the image, guard and Pi versions.
# shellcheck disable=SC2034 # consumed by the sourced lib/cmd modules
WRAPPER_VERSION="0.16.0"

# Keep temporary files in the approved scratch dir unless overridden.
# Bare `mktemp` honors TMPDIR, so relay sockets and logs land there. /tmp/pi is
# a fixed name in a shared directory: use it only when this user owns it and
# nobody else can write to it (another user could pre-create it and swap the
# files inside); otherwise plain /tmp, where mktemp's O_EXCL files are safe.
if [ -z "${TMPDIR:-}" ]; then
    TMPDIR=/tmp/pi
    (umask 077 && mkdir -p "$TMPDIR") 2>/dev/null || true
    if [ -L "$TMPDIR" ] || [ ! -d "$TMPDIR" ] || [ ! -O "$TMPDIR" ] ||
        [ $((8#$(stat -c '%a' "$TMPDIR" 2>/dev/null || echo 777) & 8#022)) -ne 0 ]; then
        TMPDIR=/tmp
    fi
    export TMPDIR
fi

# The profile decides where the config lives, so it is read before the config
# library is sourced. `--profile NAME` is a global flag in front of the command.
case "${1:-}" in
--profile)
    if [ -z "${2:-}" ]; then
        echo "pi-dockerized: --profile needs a name" >&2
        exit 1
    fi
    export PI_DOCKERIZED_PROFILE="$2"
    shift 2
    ;;
--profile=*)
    export PI_DOCKERIZED_PROFILE="${1#--profile=}"
    shift
    ;;
esac
if [ -n "${PI_DOCKERIZED_PROFILE:-}" ] && ! [[ "$PI_DOCKERIZED_PROFILE" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]]; then
    echo "pi-dockerized: invalid profile '$PI_DOCKERIZED_PROFILE' (use a-z, 0-9, - or _, up to 32 characters)" >&2
    exit 1
fi

# Profile resolution order: --profile / PI_DOCKERIZED_PROFILE (explicit) >
# profile.map (per project, applied later in main) > setting.default_profile
# (root config). `--profile default` names the default profile
# (profiles/default), escaping an inherited default_profile. PI_PROFILE_SOURCE tells the mapping step whether
# the choice was explicit. Exit code 3 = bad host config (E_CONFIG).
# The config root comes from the environment only in test mode (see core.sh).
[ "${PI_DOCKERIZED_TEST:-}" = 1 ] || unset PI_CONFIG_ROOT
_pi_config_root="${PI_CONFIG_ROOT:-$HOME/.config/pi-dockerized}"
PI_PROFILE_SOURCE=none
if [ -n "${PI_DOCKERIZED_PROFILE:-}" ]; then
    PI_PROFILE_SOURCE=explicit
    if [ "$PI_DOCKERIZED_PROFILE" = default ]; then
        unset PI_DOCKERIZED_PROFILE
    fi
else
    # setting.default_profile is read from the ROOT config only: a profile
    # must not redirect to another profile.
    _default_profile="$(sed -n 's/^[[:space:]]*setting\.default_profile[[:space:]]*=[[:space:]]*//p' \
        "$_pi_config_root/config" 2>/dev/null | head -n 1 | tr -d '[:space:]')"
    if [ -n "$_default_profile" ]; then
        if ! [[ "$_default_profile" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]]; then
            echo "pi-dockerized: invalid setting.default_profile '$_default_profile' in $_pi_config_root/config" >&2
            exit 3
        fi
        if [ "$_default_profile" != default ]; then
            export PI_DOCKERIZED_PROFILE="$_default_profile"
            PI_PROFILE_SOURCE=default
        fi
    fi
    unset _default_profile
fi
export PI_PROFILE_SOURCE

# A named profile must already exist: a typo must not silently run a session
# with a fresh empty profile and default settings. Only `install` creates one
# implicitly; `profile create NAME` is the explicit path. `profile` itself
# stays usable so a dangling default_profile can be inspected and repaired.
if [ -n "${PI_DOCKERIZED_PROFILE:-}" ] && [ ! -d "$_pi_config_root/profiles/$PI_DOCKERIZED_PROFILE" ] &&
    [ "${1:-}" != install ] && [ "${1:-}" != profile ]; then
    echo "pi-dockerized: profile '$PI_DOCKERIZED_PROFILE' does not exist." >&2
    if [ "$PI_PROFILE_SOURCE" = default ]; then
        echo "pi-dockerized: it is set as setting.default_profile; fix it with 'pi-dockerized --profile default config set default_profile <name>'." >&2
    else
        echo "pi-dockerized: create it with 'pi-dockerized profile create $PI_DOCKERIZED_PROFILE' or 'pi-dockerized --profile $PI_DOCKERIZED_PROFILE install'." >&2
    fi
    exit 3
fi
unset _pi_config_root

# Shared configuration, logging (print_*) and command modules.
source "$REPO_ROOT/lib/config-lib.sh"
for _cmd_module in help session sessions extensions image update config profile; do
    # shellcheck source=/dev/null
    source "$REPO_ROOT/lib/cmd/$_cmd_module.sh"
done
unset _cmd_module

# Function to check if Docker is running
check_docker() {
    if ! docker info >/dev/null 2>&1; then
        print_error "Docker is not running. Please start Docker and try again."
        exit 1
    fi
}

# Refuse to run as root. The container is launched with the host UID/GID, so a
# root invocation would start the sandbox as root and defeat the whole setup.
check_not_root() {
    if [ "$(id -u)" -eq 0 ]; then
        print_error "Do not run this wrapper as root."
        print_info "Run it as your normal user so the container starts as your host UID/GID."
        exit 1
    fi
}

# Function to check required host-side configuration (self-contained PI_HOME tree)
check_config() {
    # Ensure the host state tree exists and is seeded (also runs on first use).
    ensure_pi_dirs
}

# Main script logic
main() {
    check_not_root
    # Upgrades from the old layout (default profile in the config root) move
    # it into profiles/default once, before any command touches its files.
    migrate_legacy_layout || exit "$E_CONFIG"

    local command="${1:-run}"
    shift || true

    # Session commands may be mapped to a profile by project directory
    # (profile.map in the root config); re-execs with --profile when so.
    case "$command" in
    run | shell | exec)
        maybe_switch_mapped_profile "$command" "$@"
        ;;
    esac

    case "$command" in
    run)
        # `run --list` only reads local session files: no daemon needed.
        case " $* " in
        *" --list "*)
            check_config
            ;;
        *)
            check_docker
            check_config
            ;;
        esac
        run_pi "$@"
        ;;
    auth)
        check_docker
        run_auth
        ;;
    models)
        check_docker
        list_models "$@"
        ;;
    exec)
        check_docker
        exec_prompt "$@"
        ;;
    shell)
        check_docker
        check_config
        run_shell "$@"
        ;;
    mcp)
        check_docker
        manage_mcp "$@"
        ;;
    extensions | plugin)
        check_docker
        manage_extensions "$@"
        ;;
    stats)
        check_docker
        show_stats "$@"
        ;;
    debug | doctor)
        # Pi has no `debug` subcommand; map it to doctor for convenience.
        check_docker
        if [ "${1:-}" = "--fix" ]; then
            # Host-side repairs only (permissions, missing dirs/files): sync
            # never edits mcp.json content or secrets. Then diagnose as usual.
            parse_config || true
            print_info "Repairing host state..."
            sync_pi_state || exit 1
        elif [ -n "${1:-}" ]; then
            print_error "Usage: $0 doctor [--fix]"
            exit 1
        fi
        run_doctor
        ;;
    audit)
        parse_config
        show_audit "$@"
        ;;
    ps)
        check_docker
        list_sessions "$@"
        ;;
    stop)
        check_docker
        stop_sessions "$@"
        ;;
    build)
        check_docker
        build_image "$@"
        ;;
    pull)
        check_docker
        pull_image "$@"
        ;;
    rollback)
        check_docker
        rollback_image
        ;;
    install)
        # A new profile is claimed like `profile create` does (no duplicate
        # names); the wizard then seeds it.
        if [ -n "$PI_PROFILE" ] && [ ! -d "$(profile_dir "$PI_PROFILE")" ]; then
            claim_profile_dir "$PI_PROFILE" || exit $?
        fi
        # shellcheck source=lib/install-lib.sh
        source "$REPO_ROOT/lib/install-lib.sh"
        run_install_main "$@"
        ;;
    uninstall)
        # shellcheck source=lib/install-lib.sh
        source "$REPO_ROOT/lib/install-lib.sh"
        run_uninstall "$@"
        ;;
    upgrade)
        upgrade_wrapper "$@"
        ;;
    update)
        update_pi "$@"
        ;;
    version)
        check_docker
        show_version
        ;;
    config)
        # Local-only command: works without a running Docker daemon.
        show_config "$@"
        ;;
    profile)
        # Local-only, except `profile run` (re-execs into `run`).
        manage_profile "$@"
        ;;
    clean)
        check_docker
        clean_image
        ;;
    help | --help | -h)
        show_help
        ;;
    *)
        print_error "Unknown command: $command"
        echo >&2
        show_help >&2
        exit 1
        ;;
    esac
}

# Run main function
main "$@"
